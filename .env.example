NODE_ENV=production
SEMACHAT_SECRET=change-me-to-a-long-random-string-of-48-plus-characters
# Developer console: these emails can sign in (a code is emailed to them). Comma separated.
SEMACHAT_ADMIN_EMAILS=you@your-domain.example
SEMACHAT_ORIGIN=https://your-domain.example
# Login codes for users AND the developer console are emailed from the app mailbox login1@wavehub.co.ke
# (6 characters, capital letters and numbers, valid 5 minutes). Use your mailbox's SMTP details:
SMTP_HOST=mail.wavehub.co.ke
SMTP_PORT=465
SMTP_USER=login1@wavehub.co.ke
SMTP_PASS=
EMAIL_FROM=SemaChat <login1@wavehub.co.ke>
# (alternative to SMTP: a Resend API key)
RESEND_API_KEY=
# M-Pesa Daraja (STK push top-ups)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.example/api/pay/mpesa/callback
# Calls: TURN relay (recommended) and optional LiveKit for big conference calls
SEMACHAT_TURN_URL=
SEMACHAT_TURN_USER=
SEMACHAT_TURN_CRED=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Serve the developer console (and /api/admin/*) only on this hostname, e.g. console.example.com. Empty = also available at /console on the main host.
SEMACHAT_CONSOLE_HOST=

# ---- DEVELOPMENT TEAM ENTRY PASS (staging only): private link https://YOUR-SITE/team#pass=THE-PASS&who=name opens BOTH consoles, no sign-in.
# Make a pass with:  openssl rand -hex 12 | tr a-f A-F      (16-64 letters/numbers). Leave empty for real clients.
SEMACHAT_TEAM_PASS=

# ---- DEVELOPMENT TEAM ACCESS (staging / research only; leave OFF for real clients) ----
# Lets the listed team emails sign in to BOTH the client app and the developer console with one shared team code (no email needed).
# Make a code with:  openssl rand -hex 6 | tr a-f A-F      (10-32 letters/numbers; hyphens and spaces are ignored)
SEMACHAT_TEAM_ACCESS=
SEMACHAT_TEAM_EMAILS=
SEMACHAT_TEAM_CODE=
