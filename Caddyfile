# Client app
your-domain.example {
  reverse_proxy semachat:3000
}

# Developer console: separate address (set SEMACHAT_CONSOLE_HOST=console.your-domain.example).
# Tip: restrict it, e.g. to your office/VPN addresses.
console.your-domain.example {
  # @blocked not remote_ip 203.0.113.0/24
  # respond @blocked 403
  reverse_proxy semachat:3000
}
